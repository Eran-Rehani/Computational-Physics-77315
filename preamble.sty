\ProvidesPackage{preamble}

%% ── Core packages ────────────────────────────────────────────────────────────
\usepackage{amsmath, amssymb, amsthm}
\usepackage[margin=1.8cm]{geometry}
\usepackage[colorlinks=true, linkcolor=blue, citecolor=blue]{hyperref}
\usepackage{enumitem}
\usepackage{booktabs}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{fancyhdr}
\usepackage{subfiles}
\usepackage{siunitx}

%% ── Font encoding + typography ───────────────────────────────────────────────
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage[protrusion=true,expansion=true]{microtype}
\frenchspacing
\widowpenalty=10000
\clubpenalty=10000

%% ── Page style ───────────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\setlength{\headheight}{14pt}
% Left header = current \part; right header = current \section/\subsection
\let\oldpart\part
\renewcommand{\part}[1]{\oldpart{#1}\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\renewcommand{\subsectionmark}[1]{\markright{#1}}
\lhead{\small\nouppercase{\leftmark}}
\rhead{\small\nouppercase{\rightmark}}
\cfoot{\thepage}

%% ── Theorem environments (eye-candy tcolorbox) ───────────────────────────────
\usepackage{eye-candy}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

%% ── General math macros ──────────────────────────────────────────────────────
\newcommand{\bigO}[1]{\mathcal{O}\!\left(#1\right)}
\newcommand{\norm}[1]{\left\lVert#1\right\rVert}
\newcommand{\abs}[1]{\left|#1\right|}
\newcommand{\grad}{\nabla}
\newcommand{\Hess}{\mathbf{H}}
\newcommand{\Jac}{\mathbf{J}}
\newcommand{\eps}{\varepsilon}
